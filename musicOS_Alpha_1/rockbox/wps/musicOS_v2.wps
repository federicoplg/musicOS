# ==================================================
# musicOS_v2
# iPod Video 5 / 5.5G - 320x240
# ==================================================

%wd


# ==================================================
# PRELOADS
# ==================================================

# Lossless
%xl(H,lossless.bmp,0,0)

# Progress bar backdrop
%xl(pb_backdrop,pb_backdrop.bmp,0,0)

# Battery states
%xl(J,batt_status.bmp,0,4,10)

# Volume bar assets
%xl(vb_backdrop,vb_backdrop.bmp,0,0)
%xl(speaker_loud,speaker_loud.bmp,285,1)

# Playback-mode sprite - unused since GENRE replaced the playback-modes viewport
#%xl(K,playback_modes_musicOS_final.bmp,0,0,10)

# Star rating strip (frame 0 = 5 greyed-out stars / unrated, frames 1..10 = rating 1..10)
%xl(L,stars.bmp,0,0,11)


# ==================================================
# LOGIC
# ==================================================

# Album art state
%?mp<|%Vd(playing)|%Vd(paused)|%Vd(playing)>

# Progress bar / Volume bar
%?mv(1.2)<%Vd(volumebar)|%Vd(pb)%Vd(elapsed)%Vd(remaining)>

# Lock state
%?mh<%Vd(locked)>

# Lossless badge - shown only for lossless codecs
%?if(%fc, =, FLAC)<%Vd(lossless)>
%?if(%fc, =, ALAC)<%Vd(lossless)>
%?if(%fc, =, WV)<%Vd(lossless)>
%?if(%fc, =, APE)<%Vd(lossless)>
%?if(%fc, =, TTA)<%Vd(lossless)>
%?if(%fc, =, SHN)<%Vd(lossless)>
%?if(%fc, =, WAV)<%Vd(lossless)>
%?if(%fc, =, AIFF)<%Vd(lossless)>
%?if(%fc, =, WAVE64)<%Vd(lossless)>


# ==================================================
# BACKGROUND
# ==================================================

%V(0,0,-,-,-)%VB
%x(WPSBackdrop,backdrop.bmp,0,0)


# ==================================================
# FONTS
# ==================================================

%Fl(2,13-Inter-SemiBold.fnt)
%Fl(3,20-Inter-SemiBold.fnt)
%Fl(4,15-Inter-Bold.fnt)


# ==================================================
# ALBUM ART - BACKGROUND
# ==================================================

%V(8,38,-156,156,-)%VB
%Vf(000000)
%Vb(FFFFFF)
%Cl(0,0,156,156,c,c)
%Cd


# ==================================================
# RETURN TO FOREGROUND
# ==================================================

%V(0,0,-,-,-)


# ==================================================
# LOCK ICON
# ==================================================

%Vl(locked,45,8,15,15,-)
%Vb(FFFFFF)
%x(lock,lock.bmp,3,2)


# ==================================================
# BATTERY ICON
# ==================================================

%V(282,3,27,20,3)
%Vf(000000)
%Vb(FFFFFF)
%?bp<%?bl<%xd(Ja)|%xd(Ja)|%xd(Ja)|%xd(Jb)|%xd(Jb)|%xd(Jb)|%xd(Jb)|%xd(Jc)|%xd(Jc)|%xd(Jc)|%xd(Jc)|%xd(Jc)|%xd(Jc)|%xd(Jd)|%xd(Jd)|%xd(Jd)|%xd(Jd)|%xd(Jd)|%xd(Jd)|%xd(Jd)|%xd(Je)|%xd(Je)>|%?bl<%xd(Jf)|%xd(Jf)|%xd(Jf)|%xd(Jg)|%xd(Jg)|%xd(Jg)|%xd(Jg)|%xd(Jh)|%xd(Jh)|%xd(Jh)|%xd(Jh)|%xd(Jh)|%xd(Jh)|%xd(Ji)|%xd(Ji)|%xd(Ji)|%xd(Ji)|%xd(Ji)|%xd(Ji)|%xd(Ji)|%xd(Jj)|%xd(Jj)>>


# ==================================================
# BATTERY PERCENTAGE
# ==================================================

%V(242,10,36,16,2)
%Vf(000000)
%Vb(FFFFFF)
%ar%bl%%


# ==================================================
# CLOCK
# ==================================================

%V(11,10,38,16,2)
%Vf(000000)
%Vb(FFFFFF)
%al%cH:%cM


# ==================================================
# TRACK NUMBER / PLAYLIST TOTAL - TOP CENTER
# ==================================================

%V(120,10,80,16,2)
%Vf(6F6F6F)
%Vb(FFFFFF)
%ac%pp of %pe


# ==================================================
# ALBUM FRAME - PLAYING
# ==================================================

%Vl(playing,8,38,-156,156,-)
%?C<%x(AlbumFramed,albumFramed.bmp,0,0)>


# ==================================================
# PAUSE OVERLAY
# ==================================================

%Vl(paused,8,38,-156,156,-)
%x(paused,paused.bmp,0,0)


# ==================================================
# PROGRESS BAR - FULL WIDTH
# ==================================================

%Vl(pb,8,207,304,10,-)
%x(pb_left,pb_left.bmp,0,1)
%pb(4,0,296,10,image,pb.bmp,backdrop,pb_backdrop)
%x(pb_right,pb_right.bmp,300,1)


# ==================================================
# ELAPSED / REMAINING TIME
# ==================================================

# Elapsed
%Vl(elapsed,8,220,60,14,2)
%Vf(6F6F6F)
%Vb(FFFFFF)
%al%pc

# Remaining
%Vl(remaining,252,220,60,14,2)
%Vf(6F6F6F)
%Vb(FFFFFF)
%ar-%pr


# ==================================================
# VOLUME BAR
# ==================================================

%Vl(volumebar,8,207,304,33,-)
%Vb(FFFFFF)

# Speaker mute
%x(speaker_mute,speaker_mute.bmp,0,4)

# Volume gauge
%pv(18,5,257,9,vb.bmp,backdrop,vb_backdrop)

# Speaker loud
%xd(speaker_loud)

# ==================================================
# TRACK TITLE
# ==================================================

%V(176,50,136,26,3)
%Vf(000000)
%Vb(FFFFFF)
%s%?it<%it|Unknown Title>


# ==================================================
# ALBUM
# (hidden when the track has no album tag)
# ==================================================

%V(176,76,136,16,2)
%Vf(6F6F6F)
%Vb(FFFFFF)
%s%?id<%id>


# ==================================================
# ARTIST
# ==================================================

%V(176,92,136,22,4)
%Vf(F24E61)
%Vb(FFFFFF)
%s%?ia<%ia|Unknown Artist>


# ==================================================
# GENRE
# (hidden when the track has no genre tag)
# ==================================================

%V(176,114,136,14,2)
%Vf(6F6F6F)
%Vb(FFFFFF)
%s%?ig<%ig>


# ==================================================
# ALBUM YEAR / BITRATE
# (year hidden when unset or 0000; bitrate hidden when unknown)
# year: take the first 4 chars so "1999-01-01 11:11" -> "1999"
# ==================================================

%V(176,128,136,14,2)
%Vf(6F6F6F)
%Vb(FFFFFF)
%?if(%iy, >, 0)<%ss(0,4,%iy) • >%?if(%fb, >, 0)<%fb kbps>


# ==================================================
# LOSSLESS - shown via LOGIC for lossless codecs only
# (FLAC, ALAC, WavPack, APE, TTA, Shorten, WAV, AIFF, Wave64)
# ==================================================

%Vl(lossless,197,170,89,20,-)
%xd(Ha)


# ==================================================
# STAR RATING - CURRENT TRACK
# frame La = 5 greyed-out stars, always drawn as the background, so an
# unrated track (or database / "Gather runtime data" disabled) shows
# just the greyed-out stars. %?rr then paints the rated frame
# (Lb = rating 1 ... Lk = rating 10) on top when a rating exists.
# ==================================================

%V(186,144,112,20,2)
%Vf(000000)
%Vb(FFFFFF)
%xd(La)
%?rr<%xd(La)|%xd(Lb)|%xd(Lc)|%xd(Ld)|%xd(Le)|%xd(Lf)|%xd(Lg)|%xd(Lh)|%xd(Li)|%xd(Lj)|%xd(Lk)>

